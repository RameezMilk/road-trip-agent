# Copy to .env (gitignored). Only the Spectrum block is needed for the Photon probe.

# --- Photon Spectrum (app.photon.codes → project Settings) ---
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# --- HTTP ---
PORT=8787
# Public HTTPS origin that app cards open (e.g. `ngrok http 8787`). No trailing slash.
PUBLIC_BASE_URL=

# --- Gated integrations: leave empty until the owner approves building them ---
GEMINI_API_KEY=
# Server-side key for Places API (New) + Routes API. Never sent to the browser.
GOOGLE_MAPS_SERVER_KEY=
# Browser key for Maps JavaScript API; restrict it by HTTP referrer to PUBLIC_BASE_URL.
GOOGLE_MAPS_BROWSER_KEY=
# Map ID (required by Advanced Markers). DEMO_MAP_ID works for local development only.
GOOGLE_MAP_ID=
# Tiger Data (Tiger Cloud) Postgres connection string.
DATABASE_URL=
# Snowflake Cortex Search over the curated public corridor corpus (REST + PAT).
SNOWFLAKE_ACCOUNT_URL=
SNOWFLAKE_PAT=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_CORTEX_SEARCH_SERVICE=

# Optional post-Gemini decision stage. No vendor is selected; keep false.
ENABLE_DECISIONS_API=false
