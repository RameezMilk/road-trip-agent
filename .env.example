# Copy to .env (gitignored). Scripts load it via `tsx --env-file-if-exists=.env`.

# --- Photon Spectrum (app.photon.codes → project Settings) ---
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# --- HTTP ---
PORT=8787
# Public HTTPS origin that app cards open (e.g. `ngrok http 8787`). No trailing slash.
PUBLIC_BASE_URL=

# --- Gemini (aistudio.google.com → API key) ---
GEMINI_API_KEY=
# Must be a Gemini 3 model: structured output + Google Search grounding together is Gemini 3 only.
GEMINI_MODEL=

# --- Tiger Data (Tiger Cloud) Postgres connection string ---
DATABASE_URL=

# --- Trip assumptions (shown on the dashboard as assumptions) ---
TRIP_TIMEZONE=America/New_York
VEHICLE_MPG=30
GAS_PRICE_USD_PER_GALLON=3.20
MIN_MEMBERS=2
# Photon card style: false = bubble that opens the near-full-screen mini-app when tapped; true = inline live card.
CARD_LIVE=false
