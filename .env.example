# Copy to .env (gitignored). Scripts load it via `tsx --env-file-if-exists=.env`.

# --- Photon Spectrum (app.photon.codes → project Settings) ---
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# First names come from this project's users (Photon dashboard → Users → first name). Override the API host only for testing.
# SPECTRUM_CLOUD_URL=https://spectrum.photon.codes

# --- HTTP ---
PORT=8787
# Public HTTPS origin that app cards open (e.g. `ngrok http 8787`). No trailing slash.
PUBLIC_BASE_URL=

# --- Gemini (aistudio.google.com → API key) ---
GEMINI_API_KEY=
# Must be a Gemini 3 model: structured output + Google Search grounding together is Gemini 3 only.
GEMINI_MODEL=

# --- OpenAI Decisions API (optional, platform.openai.com) — fast constrained choices: vote mapping, wish sorting,
# the wish-conflict check and the send-off vibe. Without a key Gemini does those steps (slower).
OPENAI_API_KEY=
OPENAI_DECISIONS_MODEL=gpt-6-luna

# --- Tiger Data (Tiger Cloud) Postgres connection string ---
DATABASE_URL=

# --- Trip assumptions (shown on the dashboard as assumptions) ---
TRIP_TIMEZONE=America/New_York
VEHICLE_MPG=30
GAS_PRICE_USD_PER_GALLON=3.20
MIN_MEMBERS=2
# Photon card style: false = bubble that opens the near-full-screen mini-app when tapped; true = inline live card.
CARD_LIVE=false

# --- Demo flow ---
# Max stops per itinerary (fewer = faster draft). `npm run demo:up` uses 6 unless set here.
MAX_STOPS=
# true = everyone approves the first itinerary before the trip starts; false = straight to the road.
REVIEW_STEP=false
# true = also send a poll-widget card with each vote; false = vote by iMessage reply only.
POLL_WIDGET=false
# Nudge members the trip is waiting on (15 s after an unanswered message, then 1, 4, 16, 64 min). false = off.
REMINDERS=true
# `npm run demo:up` tunnel: empty = Cloudflare quick tunnel, falling back to ngrok; "ngrok" = ngrok only
# (use it where trycloudflare.com is blocked; PUBLIC_BASE_URL must be your ngrok domain).
TUNNEL=
# GIF sent with the send-off when the itinerary is ready (skipped if the file is missing).
DAP_GIF_PATH=assets/dap.gif
