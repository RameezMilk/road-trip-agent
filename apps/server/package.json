{
  "name": "@rta/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "probe": "tsx --env-file-if-exists=../../.env src/probe/photon-probe.ts",
    "typecheck": "tsc --noEmit",
    "probe:history": "tsx --env-file-if-exists=../../.env src/probe/history-export.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:tail": "tsx --env-file-if-exists=../../.env src/db/tail.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "postgres": "^3.4.9",
    "spectrum-ts": "^12.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-kit": "^0.31.11"
  }
}
