{
  "name": "road-trip-agent",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n server,miniapp -c blue,green \"npm run dev -w @rta/server\" \"npm run dev -w @rta/miniapp\"",
    "probe": "npm run probe -w @rta/server --",
    "probe:history": "npm run probe:history -w @rta/server --",
    "db:migrate": "npm run db:migrate -w @rta/server",
    "db:tail": "npm run db:tail -w @rta/server --",
    "build": "npm run build -w @rta/miniapp",
    "start": "npm run start -w @rta/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
