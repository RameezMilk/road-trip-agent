{
  "name": "road-trip-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "dev:demo": "tsx --env-file-if-exists=.env src/scripts/demo.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:tail": "tsx --env-file-if-exists=.env src/scripts/db-tail.ts",
    "llm:smoke": "tsx --env-file-if-exists=.env src/scripts/llm-smoke.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@hono/node-server": "^2.1.4",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "postgres": "^3.4.9",
    "spectrum-ts": "^12.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
